{
  "lines": [
    {
      "scene": "Entry-Dialogue",
      "speaker": "Harold",
      "lineId": 1,
      "text": "Bueno, ya casi estamos, ahora solo...",
      "emotionToken": null
    },
    {
      "scene": "Entry-Dialogue",
      "speaker": "Nina",
      "lineId": 2,
      "text": "Ehhh, ¿y ahora? ¿Tenemos otro desvío?",
      "emotionToken": "nina-doubt"
    },
    {
      "scene": "Entry-Dialogue",
      "speaker": "Harold",
      "lineId": 3,
      "text": "No… No debería, es una línea recta hacia el norte para llegar a la estación.",
      "emotionToken": null
    },
    {
      "scene": "Entry-Dialogue",
      "speaker": "Nina",
      "lineId": 4,
      "text": "¿Y todos estos escombros? ¿Siempre estuvieron acá?",
      "emotionToken": null
    },
    {
      "scene": "Entry-Dialogue",
      "speaker": "Harold",
      "lineId": 5,
      "text": "… Nno, no estaban.",
      "emotionToken": null
    },
    {
      "scene": "Entry-Dialogue",
      "speaker": "Nina",
      "lineId": 6,
      "text": "¡Entonces pasó algo, viejo! ¡Dale, vamos, puede haber alguien herido en la estación!",
      "emotionToken": "nina-demand"
    },
    {
      "scene": "Inside-station",
      "speaker": "Nina",
      "lineId": 1,
      "text": "¡Pero esto está todo destruido! ¡Viejo, esto no es reciente! ¿Qué pasó acá?",
      "emotionToken": null
    },
    {
      "scene": "Inside-station",
      "speaker": "Harold",
      "lineId": 2,
      "text": "No… No lo sé… Helenna lo usa todos los días...",
      "emotionToken": null
    },
    {
      "scene": "Inside-station",
      "speaker": "Nina",
      "lineId": 3,
      "text": "¡Pero mirá el estado de esto! ¿Estás seguro que este es el tren que toma tu mujer?",
      "emotionToken": "nina-doubt"
    },
    {
      "scene": "Inside-station",
      "speaker": "Harold",
      "lineId": 4,
      "text": "...",
      "emotionToken": null
    },
    {
      "scene": "Inside-station",
      "speaker": "Harold",
      "lineId": 5,
      "text": "Va… Vayamos a pie. Tal vez averigüemos algo en la ciudad…",
      "emotionToken": null

    },
    {
      "scene": "Inside-station",
      "speaker": "Nina",
      "lineId": 6,
      "text": "¡HAROLD!",
      "emotionToken": "nina-demand"
    },
    {
      "scene": "Inside-station",
      "speaker": "Nina",
      "lineId": 7,
      "text": "¡Eh, viejo, esperá!",
      "emotionToken": null
    }
  ]
}